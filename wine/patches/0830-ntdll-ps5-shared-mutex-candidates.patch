From: Prospero Win contributors <prospero-win@localhost>
Subject: [PATCH] ntdll: mark shared mutex candidates at successful creation

Depends on 0820. Keep unrelated, pseudo and out-of-table handles on an
immediate ordinary fallback without changing signals, locking the cache
or probing server metadata. Mark only freshly created unnamed,
non-inheritable mutants, using already marshalled attributes. Serialize
creation and slot reset with close/fill under fd_cache_mutex, including
stale negative reuse. The default-off switch and native ABI are unchanged.
Server policy remains authoritative; candidate metadata retries remain
retryable. This does not establish real Wine semantics or a console gain.

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -378,6 +378,7 @@
 /* Exact canonical handle table, like Wine's fd table, never a modulo hint.
  * Page pointers and slots are acquire/release atomic. Pages are never freed.
  * fd_cache_mutex serializes every fill and all four close invalidations. */
+#define PW_MUTEX_SLOT_CANDIDATE ((uintptr_t)3)
 #define PW_MUTEX_CACHE_PAGES 128u
 #define PW_MUTEX_CACHE_SLOTS (65536u / sizeof(uintptr_t))
 static uintptr_t *shared_mutex_pages[PW_MUTEX_CACHE_PAGES];
@@ -408,9 +409,10 @@
     uintptr_t *slot, value;
     int ret;
     if (!pw_mutex_backend_ready( shared_mutex_backend ) ||
-        !(slot = shared_mutex_slot( handle, 1 ))) return 0;
+        !(slot = shared_mutex_slot( handle, 0 ))) return 0;
     value = __atomic_load_n( slot, __ATOMIC_ACQUIRE );
-    if (value == PW_MUTEX_SLOT_NEGATIVE || (value && data->ps5_mutex_token)) return value;
+    if (!value || value == PW_MUTEX_SLOT_NEGATIVE ||
+        (value != PW_MUTEX_SLOT_CANDIDATE && data->ps5_mutex_token)) return value;
     ret = shared_mutex_backend->get_word( PW_MUTEX_BACKEND_VERSION, data->tid, inprocess_teb(),
                                           handle, &word, &token, &access );
     if (ret == PW_MUTEX_LOOKUP_NEGATIVE)
@@ -439,8 +441,8 @@
     if (!data->tid || !pw_mutex_backend_ready( shared_mutex_backend )) return STATUS_NOT_IMPLEMENTED;
     slot = shared_mutex_slot( h, 0 );
     value = slot ? __atomic_load_n( slot, __ATOMIC_ACQUIRE ) : 0;
-    if (value == PW_MUTEX_SLOT_NEGATIVE) return STATUS_NOT_IMPLEMENTED;
-    if (!value || !data->ps5_mutex_token)
+    if (!value || value == PW_MUTEX_SLOT_NEGATIVE) return STATUS_NOT_IMPLEMENTED;
+    if (value == PW_MUTEX_SLOT_CANDIDATE || !data->ps5_mutex_token)
     {
         server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
         value = shared_mutex_fill( data, h );
@@ -463,6 +465,34 @@
     return STATUS_SUCCESS;
 }
 #endif
+
+/* Selection is fixed at connection. Readiness may be temporarily absent
+ * while creation still needs to publish its future candidate marker. */
+int server_shared_mutex_enabled(void)
+{
+#ifdef WINE_INPROCESS_SERVER
+    return shared_mutex_backend != NULL;
+#else
+    return 0;
+#endif
+}
+
+/* Caller holds fd_cache_mutex across the create request and this reset.
+ * Only unnamed, non-inheritable NtCreateMutant results are candidates.
+ * Clear a reused slot even for a newly ineligible mutant; do not allocate
+ * pages for unrelated or ineligible handles. The server remains authority. */
+void server_init_shared_mutex_slot( HANDLE handle, int eligible )
+{
+#ifdef WINE_INPROCESS_SERVER
+    uintptr_t *slot;
+    if (!shared_mutex_backend) return;
+    slot = shared_mutex_slot( wine_server_obj_handle( handle ), eligible );
+    if (slot) __atomic_store_n( slot, eligible ? PW_MUTEX_SLOT_CANDIDATE : 0, __ATOMIC_RELEASE );
+#else
+    (void)handle;
+    (void)eligible;
+#endif
+}

 /* Caller already holds fd_cache_mutex, beside close_inproc_sync. */
 void server_clear_shared_mutex_slot( HANDLE handle )
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -252,6 +252,8 @@
                                            LONG *prev_count );
 extern void server_clear_fast_mutex_hint( HANDLE handle );
 extern void server_clear_shared_mutex_slot( HANDLE handle );
+extern int server_shared_mutex_enabled(void);
+extern void server_init_shared_mutex_slot( HANDLE handle, int eligible );
 extern void server_enter_uninterrupted_section( pthread_mutex_t *mutex, sigset_t *sigset );
 extern int ps5_slow_log(void);
 extern ULONGLONG ps5_now_us(void);
diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -1283,8 +1283,11 @@
                                 BOOLEAN owned )
 {
     unsigned int ret;
+    obj_handle_t result;
     data_size_t len;
     struct object_attributes *objattr;
+    sigset_t sigset;
+    int shared = server_shared_mutex_enabled();

     TRACE( "access %#x, name %s, owned %u\n", access,
            attr ? debugstr_us(attr->ObjectName) : "(null)", owned );
@@ -1292,16 +1295,21 @@
     *handle = 0;
     if ((ret = wine_server_alloc_object_attributes( attr, &objattr, &len ))) return ret;

+    if (shared) server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
     SERVER_START_REQ( create_mutex )
     {
         req->access  = access;
         req->owned   = owned;
         wine_server_add_data( req, objattr, len );
         ret = wine_server_call( req );
+        if (shared) server_init_shared_mutex_slot( wine_server_ptr_handle( reply->handle ),
+                                                   !ret && !objattr->name_len && !(objattr->attributes & OBJ_INHERIT) );
         server_clear_fast_mutex_hint( wine_server_ptr_handle( reply->handle ) );
-        *handle = wine_server_ptr_handle( reply->handle );
-    }
-    SERVER_END_REQ;
+        result = reply->handle;
+    }
+    SERVER_END_REQ;
+    if (shared) server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+    *handle = wine_server_ptr_handle( result );

     free( objattr );
     return ret;
