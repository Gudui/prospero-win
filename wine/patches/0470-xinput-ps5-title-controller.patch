From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Sun, 27 Sep 2026 12:00:00 +0200
Subject: [PATCH] xinput: Read the PS5 title's controller.

A PS5 title runs Wine in-process, without winedevice. Its sink provides
four independent XInput users with state, subtype, VID/PID and rumble.
The original slot-zero entry points remain compatible. The Unix library
uses the indexed API when present and falls back to the old slot-zero
API with an older ntdll. Without a title sink, normal Wine HID remains.

---

diff --git a/dlls/xinput1_3/Makefile.in b/dlls/xinput1_3/Makefile.in
--- a/dlls/xinput1_3/Makefile.in
+++ b/dlls/xinput1_3/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = xinput1_3.dll
+UNIXLIB   = xinput1_3.so
 IMPORTLIB = xinput
 IMPORTS   = hid setupapi advapi32 user32
 
@@ -6,4 +7,5 @@ VER_FILEDESCRIPTION_STR = "Wine Common Controller API"
 VER_PRODUCTVERSION      = 9,15,779,0000
 
 SOURCES = \
-	main.c
+	main.c \
+	unixlib.c
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -44,6 +44,8 @@
 
 #include "wine/debug.h"
 
+#include "unixlib.h"
+
 DEFINE_GUID(GUID_DEVINTERFACE_WINEXINPUT,0x6c53d5fd,0x6480,0x440f,0xb6,0x18,0x47,0x67,0x50,0xc5,0xe1,0xa6);
 
 /* Not defined in the headers, used only by XInputGetStateEx */
@@ -100,6 +102,80 @@ static HANDLE update_event;
 static SRWLOCK state_lock = SRWLOCK_INIT;
 static XINPUT_STATE current_state[XUSER_MAX_COUNT];
 
+/* A PS5 title's controller: Wine runs in the title's process, with no
+ * winedevice for a HID stack, and the title keeps its DualSense's state
+ * where the Unix library (xinput1_3.so, loaded by name so that every
+ * xinput built from this source shares it) reads it. It is controller 0
+ * in place of HID devices; anywhere else the library finds no title and
+ * xinput uses HID. */
+static unixlib_handle_t title_pad;
+static BOOL title_pad_enabled = TRUE;
+static XINPUT_VIBRATION title_pad_vibration[XUSER_MAX_COUNT];
+
+static BOOL WINAPI find_title_pad(INIT_ONCE *once, void *param, void **context)
+{
+    UNICODE_STRING name = RTL_CONSTANT_STRING(L"xinput1_3");
+    unixlib_module_t module;
+    unixlib_handle_t handle;
+    NTSTATUS status;
+
+    if ((status = __wine_load_unix_lib(&name, &module, &handle)))
+    {
+        TRACE("no Unix library, status %#lx: HID controllers\n", status);
+        return TRUE;
+    }
+    if ((status = __wine_unix_call(handle, unix_pad_init, NULL)))
+    {
+        TRACE("no title, status %#lx: HID controllers\n", status);
+        __wine_unload_unix_lib(module);
+        return TRUE;
+    }
+    TRACE("controllers 0..3 are the title's\n");
+    title_pad = handle;
+    return TRUE;
+}
+
+static BOOL has_title_pad(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce(&once, find_title_pad, NULL, NULL);
+    return title_pad != 0;
+}
+
+static BOOL title_pad_state(DWORD index, XINPUT_STATE *state)
+{
+    struct xinput_state_params params = {0};
+    struct xinput_pad_state *pad = &params.state;
+
+    params.index = index;
+    if (index >= XUSER_MAX_COUNT || __wine_unix_call(title_pad, unix_pad_state, &params) || !pad->connected) return FALSE;
+    memset(state, 0, sizeof(*state));
+    state->dwPacketNumber = pad->packet;
+    if (!title_pad_enabled) return TRUE;  /* XInputEnable(FALSE): neutral, still connected */
+    state->Gamepad.wButtons = pad->buttons;
+    state->Gamepad.bLeftTrigger = pad->left_trigger;
+    state->Gamepad.bRightTrigger = pad->right_trigger;
+    state->Gamepad.sThumbLX = pad->thumb_lx;
+    state->Gamepad.sThumbLY = pad->thumb_ly;
+    state->Gamepad.sThumbRX = pad->thumb_rx;
+    state->Gamepad.sThumbRY = pad->thumb_ry;
+    return TRUE;
+}
+
+/* xinput_cs must be held */
+static void title_pad_rumble(DWORD index)
+{
+    struct xinput_rumble_params params = {0};
+
+    params.index = index;
+    if (title_pad_enabled)
+    {
+        params.left = title_pad_vibration[index].wLeftMotorSpeed;
+        params.right = title_pad_vibration[index].wRightMotorSpeed;
+    }
+    __wine_unix_call(title_pad, unix_pad_rumble, &params);
+}
+
 static void set_current_state(UINT index, const XINPUT_STATE *state)
 {
     AcquireSRWLockExclusive(&state_lock);
@@ -817,6 +893,14 @@ void WINAPI DECLSPEC_HOTPATCH XInputEnable(BOOL enable)
     to the controllers. Setting to true will send the last vibration
     value (sent to XInputSetState) to the controller and allow messages to
     be sent */
+    if (has_title_pad())
+    {
+        EnterCriticalSection(&xinput_cs);
+        title_pad_enabled = enable;
+        for (DWORD index = 0; index < XUSER_MAX_COUNT; ++index) title_pad_rumble(index);
+        LeaveCriticalSection(&xinput_cs);
+        return;
+    }
     start_update_thread();
 
     EnterCriticalSection(&xinput_cs);
@@ -835,6 +919,19 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputSetState(DWORD index, XINPUT_VIBRATION *vib
 
     TRACE("index %lu, vibration %p.\n", index, vibration);
 
+    if (has_title_pad())
+    {
+        XINPUT_STATE state;
+
+        if (index >= XUSER_MAX_COUNT || !vibration) return ERROR_BAD_ARGUMENTS;
+        if (!title_pad_state(index, &state)) return ERROR_DEVICE_NOT_CONNECTED;
+        EnterCriticalSection(&xinput_cs);
+        title_pad_vibration[index] = *vibration;
+        title_pad_rumble(index);
+        LeaveCriticalSection(&xinput_cs);
+        return ERROR_SUCCESS;
+    }
+
     start_update_thread();
 
     if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
@@ -857,6 +954,11 @@ static DWORD xinput_get_state(DWORD index, XINPUT_STATE *state)
     DWORD ret;
 
     if (!state) return ERROR_BAD_ARGUMENTS;
+    if (has_title_pad())
+    {
+        if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+        return title_pad_state(index, state) ? ERROR_SUCCESS : ERROR_DEVICE_NOT_CONNECTED;
+    }
 
     start_update_thread();
 
@@ -1128,6 +1230,11 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputGetDSoundAudioDeviceGuids(DWORD index, GUID
           debugstr_guid(capture_guid));
 
     if (index >= XUSER_MAX_COUNT || !render_guid || !capture_guid) return ERROR_BAD_ARGUMENTS;
+    if (has_title_pad())
+    {
+        XINPUT_STATE state;
+        return title_pad_state(index, &state) ? ERROR_NOT_SUPPORTED : ERROR_DEVICE_NOT_CONNECTED;
+    }
 
     EnterCriticalSection(&xinput_cs);
     ret = controllers[index].device ? ERROR_NOT_SUPPORTED : ERROR_DEVICE_NOT_CONNECTED;
@@ -1144,6 +1251,11 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputGetBatteryInformation(DWORD index, BYTE typ
     if (!once++) FIXME("index %lu, type %u, battery %p.\n", index, type, battery);
 
     if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+    if (has_title_pad())
+    {
+        XINPUT_STATE state;
+        return title_pad_state(index, &state) ? ERROR_NOT_SUPPORTED : ERROR_DEVICE_NOT_CONNECTED;
+    }
 
     EnterCriticalSection(&xinput_cs);
     ret = controllers[index].device ? ERROR_NOT_SUPPORTED : ERROR_DEVICE_NOT_CONNECTED;
@@ -1159,6 +1271,40 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputGetCapabilitiesEx(DWORD unk, DWORD index, D
 
     TRACE("unk %lu, index %lu, flags %#lx, capabilities %p.\n", unk, index, flags, caps);
 
+    if (has_title_pad())
+    {
+        XINPUT_STATE state;
+
+        struct xinput_caps_params params = {0};
+
+        if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+        if (!title_pad_state(index, &state)) return ERROR_DEVICE_NOT_CONNECTED;
+
+        params.index = index;
+        if (!caps) return ERROR_BAD_ARGUMENTS;
+        if (__wine_unix_call(title_pad, unix_pad_caps, &params)) return ERROR_DEVICE_NOT_CONNECTED;
+        memset(caps, 0, sizeof(*caps));
+        caps->Capabilities.Type = XINPUT_DEVTYPE_GAMEPAD;
+        caps->Capabilities.SubType = params.caps.subtype;
+        caps->Capabilities.Flags = params.caps.flags;
+        caps->Capabilities.Gamepad.wButtons = 0xf3ff;
+        caps->Capabilities.Gamepad.bLeftTrigger = 0xff;
+        caps->Capabilities.Gamepad.bRightTrigger = 0xff;
+        caps->Capabilities.Gamepad.sThumbLX = (SHORT)0xffc0;
+        caps->Capabilities.Gamepad.sThumbLY = (SHORT)0xffc0;
+        caps->Capabilities.Gamepad.sThumbRX = (SHORT)0xffc0;
+        caps->Capabilities.Gamepad.sThumbRY = (SHORT)0xffc0;
+        if (params.caps.flags & XINPUT_CAPS_FFB_SUPPORTED)
+        {
+            caps->Capabilities.Vibration.wLeftMotorSpeed = 0xff;
+            caps->Capabilities.Vibration.wRightMotorSpeed = 0xff;
+        }
+        caps->VendorId = params.caps.vendor_id;
+        caps->ProductId = params.caps.product_id;
+        caps->VersionNumber = params.caps.revision;
+        return ERROR_SUCCESS;
+    }
+
     start_update_thread();
 
     if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
diff --git a/dlls/xinput1_3/unixlib.c b/dlls/xinput1_3/unixlib.c
new file mode 100644
--- /dev/null
+++ b/dlls/xinput1_3/unixlib.c
@@ -0,0 +1,121 @@
+/*
+ * The PS5 title's controller, for xinput
+ *
+ * Copyright 2026 prospero-win
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "unixlib.h"
+
+/* A PS5 title runs Wine in its own process, with no winedevice to carry a
+ * HID stack. The title keeps its controller's state in its sink
+ * (wine/ps5/pw_wine_sink.h), whose calls ntdll exports; anywhere else they
+ * are missing and xinput uses HID. */
+static int (*title_pad)( struct xinput_pad_state *state );
+static void (*title_rumble)( UINT32 left, UINT32 right );
+static int (*title_pad_slot)( UINT32 index, struct xinput_pad_state *state );
+static int (*title_caps)( UINT32 index, struct xinput_pad_caps *caps );
+static void (*title_rumble_slot)( UINT32 index, UINT32 left, UINT32 right );
+
+static NTSTATUS pad_init( void *args )
+{
+    title_pad = dlsym( RTLD_DEFAULT, "pw_wine_pad" );
+    title_rumble = dlsym( RTLD_DEFAULT, "pw_wine_set_rumble" );
+    title_pad_slot = dlsym( RTLD_DEFAULT, "pw_wine_pad_slot" );
+    title_caps = dlsym( RTLD_DEFAULT, "pw_wine_pad_caps" );
+    title_rumble_slot = dlsym( RTLD_DEFAULT, "pw_wine_set_rumble_slot" );
+    if (title_pad_slot && title_caps && title_rumble_slot) return STATUS_SUCCESS;
+    title_pad_slot = NULL;
+    title_caps = NULL;
+    title_rumble_slot = NULL;
+    return title_pad ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS pad_state( void *args )
+{
+    struct xinput_state_params *params = args;
+
+    memset( &params->state, 0, sizeof(params->state) );
+    if (params->index >= 4) return STATUS_INVALID_PARAMETER;
+    if (title_pad_slot) title_pad_slot( params->index, &params->state );
+    else if (!params->index && title_pad) title_pad( &params->state );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS pad_caps( void *args )
+{
+    struct xinput_caps_params *params = args;
+    struct xinput_pad_state state;
+
+    memset( &params->caps, 0, sizeof(params->caps) );
+    if (params->index >= 4) return STATUS_INVALID_PARAMETER;
+    if (title_caps) return title_caps( params->index, &params->caps ) ? STATUS_SUCCESS : STATUS_DEVICE_NOT_CONNECTED;
+    if (params->index || !title_pad || !title_pad( &state )) return STATUS_DEVICE_NOT_CONNECTED;
+    params->caps.subtype = 1;
+    params->caps.vendor_id = 0x045e;
+    params->caps.product_id = 0x028e;
+    params->caps.revision = 0x0114;
+    params->caps.flags = 1;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS pad_rumble( void *args )
+{
+    const struct xinput_rumble_params *params = args;
+
+    if (params->index >= 4) return STATUS_INVALID_PARAMETER;
+    if (title_rumble_slot) title_rumble_slot( params->index, params->left, params->right );
+    else if (!params->index && title_rumble) title_rumble( params->left, params->right );
+    else return STATUS_NOT_SUPPORTED;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    pad_init,
+    pad_state,
+    pad_rumble,
+    pad_caps,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    pad_init,
+    pad_state,
+    pad_rumble,
+    pad_caps,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif /* _WIN64 */
diff --git a/dlls/xinput1_3/unixlib.h b/dlls/xinput1_3/unixlib.h
new file mode 100644
--- /dev/null
+++ b/dlls/xinput1_3/unixlib.h
@@ -0,0 +1,75 @@
+/*
+ * The PS5 title's controller, for xinput
+ *
+ * Copyright 2026 prospero-win
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_XINPUT_UNIXLIB_H
+#define __WINE_XINPUT_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* The layout of PwWinePad in the title's sink. It holds no pointers, so
+ * both sides of WoW64 read it alike and the 32-bit calls need no thunks. */
+struct xinput_pad_state
+{
+    UINT32 connected;
+    UINT32 packet;
+    UINT16 buttons;
+    BYTE left_trigger;
+    BYTE right_trigger;
+    INT16 thumb_lx;
+    INT16 thumb_ly;
+    INT16 thumb_rx;
+    INT16 thumb_ry;
+};
+
+struct xinput_pad_caps
+{
+    UINT32 subtype;
+    UINT16 vendor_id, product_id, revision, flags;
+};
+
+struct xinput_state_params
+{
+    UINT32 index;
+    struct xinput_pad_state state;
+};
+
+struct xinput_caps_params
+{
+    UINT32 index;
+    struct xinput_pad_caps caps;
+};
+
+struct xinput_rumble_params
+{
+    UINT32 index;
+    UINT32 left;
+    UINT32 right;
+};
+
+enum xinput_unix_funcs
+{
+    unix_pad_init,
+    unix_pad_state,
+    unix_pad_rumble,
+    unix_pad_caps,
+    unix_funcs_count,
+};
+
+#endif /* __WINE_XINPUT_UNIXLIB_H */
-- 
