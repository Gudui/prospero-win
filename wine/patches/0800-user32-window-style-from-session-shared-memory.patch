 /**********************************************************************
+ * The window style from the session shared memory
+ *
+ * GetWindowLong(GWL_STYLE), and with it IsIconic and IsZoomed, is a system
+ * call into win32u, and under WoW64 every system call is a full crossing to
+ * the 64-bit side. The server keeps a copy of each window's style in the
+ * window's shared object, next to the data win32u already reads from there,
+ * and marks it valid once the creating process initialised the window. From
+ * then on win32u's copy follows the server's: every change goes through the
+ * server first. So for the windows of this process user32 can read the style
+ * itself. Whatever this cannot answer exactly (other processes' windows,
+ * invalid handles, windows still being created, a busy writer) goes to win32u.
+ */
+#if defined(__i386__) || defined(__x86_64__)
+
+/* x86 keeps loads in order: only the compiler must not move them */
+#define SHARED_READ_FENCE() __asm__ __volatile__( "" ::: "memory" )
+#define MAX_SESSION_VIEWS   8   /* the session section grows: remap it at most this often */
+
+struct session_view
+{
+    const char *base;
+    SIZE_T      size;
+};
+
+static struct session_view *session_view;
+static LONG session_view_maps;
+
+/* The counter only increases: each failed CAS observes a later reservation,
+ * so this retries at most MAX_SESSION_VIEWS times. No reader reserves beyond
+ * the budget, including concurrent first views and failed mapping attempts. */
+static BOOL reserve_session_view(void)
+{
+    LONG count = ReadAcquire( &session_view_maps ), previous;
+
+    while (count < MAX_SESSION_VIEWS)
+    {
+        previous = InterlockedCompareExchange( &session_view_maps, count + 1, count );
+        if (previous == count) return TRUE;
+        count = previous;
+    }
+    return FALSE;
+}
+
+/* a read-only view of the session shared memory that covers [0, needed) */
+static const struct session_view *get_session_view( SIZE_T needed )
+{
+    static const WCHAR nameW[] = L"\\KernelObjects\\__wine_session";
+    UNICODE_STRING name = RTL_CONSTANT_STRING( nameW );
+    struct session_view *view = ReadPointerAcquire( (void **)&session_view ), *new_view;
+    LARGE_INTEGER offset = {{0}};
+    OBJECT_ATTRIBUTES attr;
+    void *base = NULL;
+    SIZE_T size = 0;
+    NTSTATUS status;
+    HANDLE handle;
+
+    if (view && view->size >= needed) return view;
+    if (!reserve_session_view()) return NULL;
+
+    InitializeObjectAttributes( &attr, &name, 0, NULL, NULL );
+    if (NtOpenSection( &handle, SECTION_MAP_READ, &attr )) return NULL;
+    status = NtMapViewOfSection( handle, GetCurrentProcess(), &base, 0, 0, &offset, &size,
+                                 ViewUnmap, 0, PAGE_READONLY );
+    NtClose( handle );
+    if (status) return NULL;
+    if (size < needed || size < sizeof(session_shm_t) ||
+        !(new_view = HeapAlloc( GetProcessHeap(), 0, sizeof(*new_view) )))
+    {
+        NtUnmapViewOfSection( GetCurrentProcess(), base );
+        return NULL;
+    }
+    new_view->base = base;
+    new_view->size = size;
+    /* an older view stays mapped: another thread may still be reading it */
+    if (InterlockedCompareExchangePointer( (void **)&session_view, new_view, view ) != view)
+    {
+        NtUnmapViewOfSection( GetCurrentProcess(), base );
+        HeapFree( GetProcessHeap(), 0, new_view );
+        view = ReadPointerAcquire( (void **)&session_view );
+        return view->size >= needed ? view : NULL;
+    }
+    return new_view;
+}
+
+/* the low half of a 64-bit shared value: enough for generations and sequence numbers */
+static inline LONG read_low_dword( const volatile LONG64 *ptr )
+{
+    return *(const volatile LONG *)ptr;
+}
+
+static BOOL get_shared_window_style( HWND hwnd, DWORD *style )
+{
+    static const SIZE_T object_size = offsetof(shared_object_t, shm) + offsetof(window_shm_t, extra);
+    UINT index = ((UINT)LOWORD(hwnd) - FIRST_USER_HANDLE) >> 1;
+    const volatile struct user_entry *entry;
+    const struct session_view *view;
+    const shared_object_t *object;
+    UINT64 offset, id, object_id = 0;
+    LONG uniq, seq;
+    UINT valid = 0, value = 0, pid, tries;
+
+    if (index >= MAX_USER_HANDLES) return FALSE;
+    if (!(view = get_session_view( sizeof(session_shm_t) ))) return FALSE;
+
+    /* the handle table entry, read as win32u reads it */
+    entry = &((const session_shm_t *)view->base)->user_entries[index];
+    uniq = read_low_dword( &entry->uniq );
+    if (!HIWORD(hwnd) || HIWORD(hwnd) == 0xffff)
+    {
+        if (LOWORD(uniq) != NTUSER_OBJ_WINDOW) return FALSE;
+    }
+    else if (uniq != MAKELONG( NTUSER_OBJ_WINDOW, HIWORD(hwnd) )) return FALSE;
+    SHARED_READ_FENCE();
+    offset = entry->offset;
+    id = entry->id;
+    pid = entry->pid;
+    SHARED_READ_FENCE();
+    if (read_low_dword( &entry->uniq ) != uniq) return FALSE;
+    if (pid != GetCurrentProcessId()) return FALSE;
+
+    if (offset > view->size || view->size - offset < object_size)
+    {
+        if (offset > ~(SIZE_T)0 - object_size) return FALSE;
+        if (!(view = get_session_view( offset + object_size ))) return FALSE;
+    }
+    object = (const shared_object_t *)(view->base + offset);
+
+    /* the server writes under a sequence lock; never wait for it here */
+    for (tries = 0; ; tries++)
+    {
+        if (tries == 16) return FALSE;
+        seq = read_low_dword( &object->seq );
+        if (seq & 1) continue;
+        SHARED_READ_FENCE();
+        object_id = object->id;
+        valid = object->shm.window.style_valid;
+        value = object->shm.window.style;
+        SHARED_READ_FENCE();
+        if (read_low_dword( &object->seq ) == seq) break;
+    }
+    if (object_id != id || valid != WINDOW_STYLE_SHARED_TAG) return FALSE;
+    *style = value;
+    return TRUE;
+}
+
+#else
+static BOOL get_shared_window_style( HWND hwnd, DWORD *style ) { return FALSE; }
+#endif
+
+
