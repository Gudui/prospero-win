+/* x86 keeps loads in order: only the compiler must not move them. */
+#if defined(__i386__) || defined(__x86_64__)
+#define STYLE_READ_FENCE() __asm__ __volatile__( "" ::: "memory" )
+#define MAX_STYLE_VIEW_ATTEMPTS 8
+
+static const struct pw_window_style_table *style_view;
+static LONG style_view_attempts;
+
+/* Monotonic reservations bound all attempts, including concurrent failures. */
+static BOOL reserve_style_view(void)
+{
+    LONG count = ReadAcquire( &style_view_attempts ), previous;
+
+    while (count < MAX_STYLE_VIEW_ATTEMPTS)
+    {
+        previous = InterlockedCompareExchange( &style_view_attempts, count + 1, count );
+        if (previous == count) return TRUE;
+        count = previous;
+    }
+    return FALSE;
+}
+
+static const struct pw_window_style_table *get_style_view(void)
+{
+    static const WCHAR nameW[] = L"\\KernelObjects\\__wine_window_styles";
+    UNICODE_STRING name = RTL_CONSTANT_STRING( nameW );
+    const struct pw_window_style_table *view = ReadPointerAcquire( (void **)&style_view ), *previous;
+    LARGE_INTEGER offset = {{0}};
+    OBJECT_ATTRIBUTES attr;
+    void *base = NULL;
+    SIZE_T size = 0;
+    NTSTATUS status;
+    HANDLE handle;
+
+    if (view) return view;
+    if (!reserve_style_view()) return NULL;
+
+    InitializeObjectAttributes( &attr, &name, 0, NULL, NULL );
+    if (NtOpenSection( &handle, SECTION_MAP_READ, &attr )) return NULL;
+    status = NtMapViewOfSection( handle, GetCurrentProcess(), &base, 0, 0, &offset, &size,
+                                 ViewUnmap, 0, PAGE_READONLY );
+    NtClose( handle );
+    if (status) return NULL;
+    view = base;
+    if (size < sizeof(*view) || view->magic != PW_WINDOW_STYLE_MAGIC ||
+        view->version != PW_WINDOW_STYLE_VERSION || view->entry_size != sizeof(view->entries[0]) ||
+        view->count != PW_WINDOW_STYLE_COUNT)
+    {
+        NtUnmapViewOfSection( GetCurrentProcess(), base );
+        return NULL;
+    }
+    previous = InterlockedCompareExchangePointer( (void **)&style_view, (void *)view, NULL );
+    if (previous)
+    {
+        NtUnmapViewOfSection( GetCurrentProcess(), base );
+        return previous;
+    }
+    /* The fixed view remains mapped for this module's process lifetime. */
+    return view;
+}
+
+static BOOL get_shared_window_style( HWND hwnd, DWORD *style )
+{
+    UINT index = ((UINT)LOWORD(hwnd) - PW_WINDOW_STYLE_FIRST) >> 1;
+    const volatile struct pw_window_style_entry *entry;
+    const struct pw_window_style_table *view;
+    UINT seq, handle = 0, pid = 0, valid = 0, value = 0, tries;
+
+    if (index >= PW_WINDOW_STYLE_COUNT || !(view = get_style_view())) return FALSE;
+    entry = &view->entries[index];
+    for (tries = 0; tries < 16; tries++)
+    {
+        seq = entry->seq;
+        if (seq & 1) continue;
+        STYLE_READ_FENCE();
+        handle = entry->handle;
+        pid = entry->pid;
+        valid = entry->ready;
+        value = entry->style;
+        STYLE_READ_FENCE();
+        if (entry->seq == seq) break;
+    }
+    if (tries == 16 || valid != PW_WINDOW_STYLE_READY || pid != GetCurrentProcessId()) return FALSE;
+    /* Match win32u's low-word / 0xffff aliases, including its low handle bit. */
+    if (((handle & 0xffff) - PW_WINDOW_STYLE_FIRST) >> 1 != index) return FALSE;
+    if (HIWORD(hwnd) && HIWORD(hwnd) != 0xffff && HIWORD(hwnd) != HIWORD(handle)) return FALSE;
+    *style = value;
+    return TRUE;
+}
+
+#else
+static BOOL get_shared_window_style( HWND hwnd, DWORD *style ) { return FALSE; }
+#endif
+
