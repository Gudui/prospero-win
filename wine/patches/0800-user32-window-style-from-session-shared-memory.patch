+/* Independent opt-in, initialized under the authoritative server lock.
+ * Do not retain a descriptor. Strict environment selection wins over prefix
+ * contents; absence, malformed settings and I/O failure leave queries ordinary. */
+static int ps5_window_style_shared_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+    char buffer[3];
+    int file, result = 0, saved_errno = errno;
+    size_t count = 0;
+    ssize_t size = -1;
+
+    if (enabled != -1) return enabled;
+    if ((value = getenv( "WINE_PS5_WINDOW_STYLE_SHARED" )))
+        result = !strcmp( value, "1" );
+    else if (config_dir_fd != -1 &&
+             (file = openat( config_dir_fd, "pw_window_style_shared", O_RDONLY )) != -1)
+    {
+        while (count < sizeof(buffer) &&
+               (size = read( file, buffer + count, sizeof(buffer) - count )) > 0)
+            count += size;
+        close( file );
+        result = size == 0 && (count == 1 || (count == 2 && buffer[1] == '\n')) &&
+                 buffer[0] == '1';
+    }
+    enabled = result;
+    fprintf( stderr, "wine-ps5: shared window-style queries: %s\n", enabled ? "on" : "off" );
+    errno = saved_errno;
+    return enabled;
+}
+
+/* set the window style, and its copy in the shared memory that user32 reads */
+static void set_window_style( struct window *win, unsigned int style )
+{
+    win->style = style;
+    SHARED_WRITE_BEGIN( win->shared, window_shm_t )
+    {
+        shared->style = style;
+    }
+    SHARED_WRITE_END;
+}
+
 /* check if window is orphaned */
 static int is_orphan_window( struct window *win )
 {
     do if (win->is_orphan) return 1;
     while ((win = win->parent));
     return 0;
 }

