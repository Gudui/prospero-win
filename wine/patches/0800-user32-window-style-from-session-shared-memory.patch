+static int ps5_window_style_shared_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+    char buffer[3];
+    int file, result = 0, saved_errno = errno;
+    size_t count = 0;
+    ssize_t size = -1;
+
+    if (enabled != -1) return enabled;
+    if ((value = getenv( "WINE_PS5_WINDOW_STYLE_SHARED" )))
+        result = !strcmp( value, "1" );
+    else if (config_dir_fd != -1 &&
+             (file = openat( config_dir_fd, "pw_window_style_shared", O_RDONLY )) != -1)
+    {
+        while (count < sizeof(buffer) &&
+               (size = read( file, buffer + count, sizeof(buffer) - count )) > 0)
+            count += size;
+        close( file );
+        result = size == 0 && (count == 1 || (count == 2 && buffer[1] == '\n')) &&
+                 buffer[0] == '1';
+    }
+    enabled = result;
+    fprintf( stderr, "wine-ps5: shared window-style queries: %s\n", enabled ? "on" : "off" );
+    errno = saved_errno;
+    return enabled;
+}
+
+static volatile struct pw_window_style_table *window_style_table;
+
+/* Optional namespace creation must not change ordinary startup error state. */
+void init_window_style_mapping( struct object *root, struct unicode_str name )
+{
+    int saved_errno = errno;
+    unsigned int saved_error = get_error();
+
+    if (ps5_window_style_shared_enabled())
+    {
+        window_style_table = create_window_style_mapping( root, name, sizeof(*window_style_table) );
+        if (window_style_table)
+        {
+            window_style_table->version = PW_WINDOW_STYLE_VERSION;
+            window_style_table->entry_size = sizeof(window_style_table->entries[0]);
+            window_style_table->count = PW_WINDOW_STYLE_COUNT;
+            __atomic_store_n( &window_style_table->magic, PW_WINDOW_STYLE_MAGIC, __ATOMIC_RELEASE );
+        }
+    }
+    set_error( saved_error );
+    errno = saved_errno;
+}
+
+/* Serialized by the existing server lock. Publish complete records atomically
+ * with respect to the bounded x86 sequence reader; win->style stays authoritative. */
+static void publish_window_style( struct window *win )
+{
+    volatile struct pw_window_style_entry *entry;
+    unsigned int index = ((win->handle & 0xffff) - PW_WINDOW_STYLE_FIRST) >> 1;
+
+    if (!window_style_table || !win->handle || index >= PW_WINDOW_STYLE_COUNT) return;
+    entry = &window_style_table->entries[index];
+    __atomic_add_fetch( &entry->seq, 1, __ATOMIC_SEQ_CST );
+    entry->handle = win->handle;
+    entry->pid = win->thread ? win->thread->process->id : 0;
+    entry->style = win->style;
+    entry->ready = win->style_shared_ready && win->thread ? PW_WINDOW_STYLE_READY : 0;
+    __atomic_add_fetch( &entry->seq, 1, __ATOMIC_RELEASE );
+}
+
+static void retire_window_style( struct window *win )
+{
+    win->style_shared_ready = 0;
+    publish_window_style( win );
+}
+
+static void set_window_style( struct window *win, unsigned int style )
+{
+    win->style = style;
+    publish_window_style( win );
+}
