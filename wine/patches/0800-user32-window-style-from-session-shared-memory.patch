diff --git a/include/wine/window_style_shared.h b/include/wine/window_style_shared.h
new file mode 100644
--- /dev/null
+++ b/include/wine/window_style_shared.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Independent style publication ABI; the Wine server protocol is unchanged. */
+#ifndef __WINE_WINDOW_STYLE_SHARED_H
+#define __WINE_WINDOW_STYLE_SHARED_H
+
+#include <stdint.h>
+
+#define PW_WINDOW_STYLE_MAGIC   0x57535459u
+#define PW_WINDOW_STYLE_VERSION 1u
+#define PW_WINDOW_STYLE_FIRST   0x20u
+#define PW_WINDOW_STYLE_COUNT   32744u
+#define PW_WINDOW_STYLE_READY   0x57530001u
+
+/* Fixed width and pointer-free in both PE architectures. Never resized. */
+struct pw_window_style_entry
+{
+    uint32_t seq;
+    uint32_t handle;
+    uint32_t pid;
+    uint32_t style;
+    uint32_t ready;
+    uint32_t reserved[3];
+};
+
+struct pw_window_style_table
+{
+    uint32_t magic;
+    uint32_t version;
+    uint32_t entry_size;
+    uint32_t count;
+    uint32_t reserved[4];
+    struct pw_window_style_entry entries[PW_WINDOW_STYLE_COUNT];
+};
+
+#endif
