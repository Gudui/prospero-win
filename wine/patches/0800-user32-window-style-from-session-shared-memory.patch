+/* Fixed optional section: one mmap, no growth and no extra retained fd. */
+volatile void *create_window_style_mapping( struct object *root, struct unicode_str name, size_t size )
+{
+    struct mapping_init_data data = { .size = round_size( size, host_page_mask ), .flags = SEC_COMMIT,
+                                      .file_access = FILE_READ_DATA | FILE_WRITE_DATA };
+    struct object_params params = { .ops = &mapping_ops, .root = root, .name = name,
+                                    .attr = OBJ_PERMANENT, .sd = NULL, .init_data = &data };
+    struct mapping *mapping;
+    void *view = NULL;
+    int unix_fd, saved_errno = errno;
+    unsigned int saved_error = get_error();
+
+    if ((mapping = create_named_object( &params )))
+    {
+        unix_fd = get_unix_fd( mapping->fd );
+        if (unix_fd != -1)
+        {
+            view = mmap( NULL, data.size, PROT_READ | PROT_WRITE, MAP_SHARED, unix_fd, 0 );
+            if (view == MAP_FAILED) view = NULL;
+        }
+        release_object( mapping );
+    }
+    set_error( saved_error );
+    errno = saved_errno;
+    return view;
+}
+
 struct mapping *create_session_mapping( struct object *root, struct unicode_str name,
                                         unsigned int attr, const struct security_descriptor *sd )
 {
     size_t size = max( sizeof(*shared_session) + sizeof(object_shm_t) * 512, 0x10000 );
     struct mapping_init_data data = { .size = round_size( size, host_page_mask ), .flags = SEC_COMMIT,
                                       .file_access = FILE_READ_DATA | FILE_WRITE_DATA };
     struct object_params params = { .ops = &mapping_ops, .root = root, .name = name,
                                     .attr = attr, .sd = sd, .init_data = &data };
