From: Prospero Win contributors <prospero-win@localhost>
Subject: [PATCH] ntdll: retain explicit guest edits before BOP publication

Record only explicit Wow64 guest edits, independent of native host FP frames.
Merge changed field groups with the current engine guest snapshot under the
existing VM lease; preserve SSE on legacy x87 edits. No consumer activation.

diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -124,10 +124,11 @@
     LONGLONG     ps5_sleep_asked;   /* microseconds of sleep asked since then */
     char         debug_info[0x800]; /* debug_info structure */
 #if defined(__x86_64__) && (defined(__PROSPERO__) || defined(WINE_INPROCESS_SERVER))
     void        *ps5_sync_bop_context; /* atomic native transaction view, normally NULL */
     void        *ps5_sync_bop_memory; /* current-thread bounded VM lease, normally NULL */
+    void        *ps5_sync_bop_pending; /* explicitly attached CPU observer, normally NULL */
 #endif
     char         signal_stack[];    /* signal stack */
     /* char kernel_stack[] */
 };
 
@@ -300,10 +301,11 @@
 extern void *get_cpu_area( struct thread_data *data, USHORT machine );
 #if defined(__x86_64__) && (defined(__PROSPERO__) || defined(WINE_INPROCESS_SERVER))
 extern void *ps5_sync_bop_cpu_area( struct thread_data *data );
 extern void ps5_sync_bop_context_edit( struct thread_data *data );
 extern void ps5_sync_bop_context_resumed( struct thread_data *data, unsigned int flags );
+extern void ps5_sync_bop_pending_edit( struct thread_data *data, const I386_CONTEXT *context, unsigned int flags );
 #endif
 extern void set_thread_id( struct thread_data *data );
 extern NTSTATUS init_thread_stack( TEB *teb, ULONG_PTR limit, SIZE_T reserve_size, SIZE_T commit_size );
 extern void DECLSPEC_NORETURN abort_thread( int status );
 extern void DECLSPEC_NORETURN abort_process( int status );
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -83,10 +83,12 @@
 #include "wine/list.h"
 #include "wine/asm.h"
 #include "unix_private.h"
 #if defined(__PROSPERO__) || defined(WINE_INPROCESS_SERVER)
 #include "wine/ps5_sync_bop_context.h"
+#include "wine/ps5_sync_bop_memory.h"
+#include "wine/ps5_sync_bop_pending.h"
 #endif
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(unwind);
 WINE_DECLARE_DEBUG_CHANNEL(seh);
@@ -1047,10 +1049,151 @@
