@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Native-only observer-aware I386 context publication; no guest pointers. */
+#ifndef __WINE_PS5_SYNC_BOP_CONTEXT_H
+#define __WINE_PS5_SYNC_BOP_CONTEXT_H
+#include <stdint.h>
+#define PW_BOP_CONTEXT_VERSION 1u
+#define PW_BOP_CONTEXT_EMPTY 0u
+#define PW_BOP_CONTEXT_ACTIVE 1u
+#define PW_BOP_CONTEXT_COPYING 2u
+#define PW_BOP_CONTEXT_INTERRUPTED 3u
+#define PW_BOP_CONTEXT_COMMITTED 4u
+#define PW_BOP_CONTEXT_MISS 0u
+#define PW_BOP_CONTEXT_HIT 1u
+#define PW_BOP_CONTEXT_FAULT 2u
+#define PW_BOP_CONTEXT_UNCHANGED 0u
+#define PW_BOP_CONTEXT_REPLACED 1u
+#define PW_BOP_CONTEXT_INVALID 2u
+
+/* Caller-owned native storage, valid through finish. shadow is a complete
+ * I386_CONTEXT snapshot including FP; observers may replace it. The API
+ * preserves the original Unix native FP frame and publishes the shadow to
+ * all I386 CPU-area and native Wow64 FP observers. */
+struct pw_sync_bop_context_view
+{
+    uint32_t version, size, phase, changes;
+    uint64_t canonical, shadow;
+};
+
+struct pw_sync_bop_context_backend
+{
+    uint32_t version, size, pointer_size, context_size;
+    int (*publish)(struct pw_sync_bop_context_view *, uint32_t context_size);
+    /* Caller supplies the popped continuation in shadow before publication.
+     * HIT commits successful EAX only if observers have not replaced it.
+     * A clean MISS restores the prior canonical view. FAULT commits the
+     * popped continuation; it never changes an already completed CAS into
+     * a retryable miss. REPLACED imports canonical GPR/FP after finish.
+     * Always recheck the CPU RESET flag before resuming guest execution. */
+    uint32_t (*finish)(struct pw_sync_bop_context_view *, uint32_t disposition);
+};
+#endif
