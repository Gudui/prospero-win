 #include "windef.h"
 #include "winternl.h"
 #include "ddk/wdm.h"
 #include "wine/list.h"
 #include "wine/asm.h"
 #include "unix_private.h"
+#if defined(__PROSPERO__) || defined(WINE_INPROCESS_SERVER)
+#include "wine/ps5_sync_bop_context.h"
+#endif
 #include "wine/debug.h"

 WINE_DEFAULT_DEBUG_CHANNEL(unwind);
 WINE_DECLARE_DEBUG_CHANNEL(seh);

 #include "dwarf.h"

 static USHORT cs32_sel;  /* selector for %cs in 32-bit mode */
@@ -1040,16 +1043,153 @@
     NTSTATUS status = NtSetContextThread( GetCurrentThread(), context );

     if (!status && (context->ContextFlags & CONTEXT_INTEGER) == CONTEXT_INTEGER)
         get_syscall_frame(get_thread_data())->restore_flags |= CONTEXT_INTEGER;
     return status;
 }


+#if defined(__PROSPERO__) || defined(WINE_INPROCESS_SERVER)
+/* Pointer publication keeps readers off a partially copied I386 context.
+ * The caller and signal handlers execute on this thread; server observers
+ * reach the same view through the existing suspension protocol. */
+void *ps5_sync_bop_cpu_area( struct thread_data *data )
+{
+    struct pw_sync_bop_context_view *view;
+
+    if (!(view = __atomic_load_n( &data->ps5_sync_bop_context, __ATOMIC_ACQUIRE ))) return NULL;
+    if (__atomic_load_n( &view->phase, __ATOMIC_ACQUIRE ) == PW_BOP_CONTEXT_COMMITTED)
+        return (void *)(ULONG_PTR)view->canonical;
+    return (void *)(ULONG_PTR)view->shadow;
+}
+
+void ps5_sync_bop_context_edit( struct thread_data *data )
+{
+    struct pw_sync_bop_context_view *view;
+
+    if (!(view = __atomic_load_n( &data->ps5_sync_bop_context, __ATOMIC_ACQUIRE ))) return;
+    __atomic_add_fetch( &view->changes, 1, __ATOMIC_RELEASE );
+    if (__atomic_load_n( &view->phase, __ATOMIC_ACQUIRE ) != PW_BOP_CONTEXT_COMMITTED)
+        __atomic_store_n( &view->phase, PW_BOP_CONTEXT_INTERRUPTED, __ATOMIC_RELEASE );
+}
+
+void ps5_sync_bop_context_resumed( struct thread_data *data, unsigned int flags )
+{
+    I386_CONTEXT *context = ps5_sync_bop_cpu_area( data );
+
+    if (!context) return;
+    if ((flags & SERVER_CTX_FLOATING_POINT) && !(flags & SERVER_CTX_EXTENDED_REGISTERS))
+        fpu_to_fpux( (XSAVE_FORMAT *)context->ExtendedRegisters, &context->FloatSave );
+}
+
+static XSAVE_FORMAT *ps5_sync_bop_fp_area( struct thread_data *data, struct syscall_frame *frame )
+{
+    I386_CONTEXT *context = ps5_sync_bop_cpu_area( data );
+    return context ? (XSAVE_FORMAT *)context->ExtendedRegisters : &frame->xsave;
+}
+
+static int ps5_sync_bop_context_publish( struct pw_sync_bop_context_view *view, uint32_t context_size )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame;
+    WOW64_CPURESERVED *cpu;
+    I386_CONTEXT *shadow;
+
+    if (!view || view->version != PW_BOP_CONTEXT_VERSION || view->size != sizeof(*view) ||
+        context_size != sizeof(I386_CONTEXT) || !data || !data->teb ||
+        __atomic_load_n( &data->ps5_sync_bop_context, __ATOMIC_ACQUIRE ) ||
+        !(frame = get_syscall_frame( data )) ||
+        !(frame->restore_flags & RESTORE_FLAGS_INCOMPLETE_FRAME_CONTEXT) || frame->prev_frame ||
+        !view->canonical || !view->shadow || view->canonical == view->shadow ||
+        (void *)(ULONG_PTR)view->canonical != get_cpu_area( data, IMAGE_FILE_MACHINE_I386 ) ||
+        ((view->shadow + offsetof(I386_CONTEXT, ExtendedRegisters)) & 15) ||
+        ((view->canonical + offsetof(I386_CONTEXT, ExtendedRegisters)) & 15)) return 0;
+    cpu = data->teb->TlsSlots[WOW64_TLS_CPURESERVED];
+    shadow = (I386_CONTEXT *)(ULONG_PTR)view->shadow;
+    if ((cpu->Flags & WOW64_CPURESERVED_FLAG_RESET_STATE) || data->teb->Peb->BeingDebugged ||
+        shadow->Dr7 || (shadow->EFlags & (0x100 | 0x10000)) ||
+        (shadow->ContextFlags & CONTEXT_I386_XSTATE) == CONTEXT_I386_XSTATE) return 0;
+
+    fpux_to_fpu( &shadow->FloatSave, (const XSAVE_FORMAT *)shadow->ExtendedRegisters );
+    shadow->ContextFlags |= CONTEXT_I386_CONTROL | CONTEXT_I386_INTEGER |
+                            CONTEXT_I386_FLOATING_POINT | CONTEXT_I386_EXTENDED_REGISTERS;
+    view->changes = 0;
+    __atomic_store_n( &view->phase, PW_BOP_CONTEXT_ACTIVE, __ATOMIC_RELEASE );
+    __atomic_store_n( &data->ps5_sync_bop_context, view, __ATOMIC_RELEASE );
+    return 1;
+}
+
+static uint32_t ps5_sync_bop_context_finish( struct pw_sync_bop_context_view *view, uint32_t disposition )
+{
+    struct thread_data *data = get_thread_data();
+    WOW64_CPURESERVED *cpu;
+    I386_CONTEXT *canonical, *shadow;
+    uint32_t expected, changed;
+    unsigned int tries;
+    sigset_t previous;
+    int blocked = 0;
+
+    if (!view || !data || disposition > PW_BOP_CONTEXT_FAULT ||
+        __atomic_load_n( &data->ps5_sync_bop_context, __ATOMIC_ACQUIRE ) != view)
+        return PW_BOP_CONTEXT_INVALID;
+    cpu = data->teb->TlsSlots[WOW64_TLS_CPURESERVED];
+    canonical = (I386_CONTEXT *)(ULONG_PTR)view->canonical;
+    shadow = (I386_CONTEXT *)(ULONG_PTR)view->shadow;
+    for (tries = 0; ; tries++)
+    {
+        changed = __atomic_load_n( &view->changes, __ATOMIC_ACQUIRE );
+        if (!changed && disposition == PW_BOP_CONTEXT_MISS)
+        {
+            expected = PW_BOP_CONTEXT_ACTIVE;
+            if (__atomic_compare_exchange_n( &view->phase, &expected, PW_BOP_CONTEXT_COMMITTED,
+                                              0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE )) break;
+        }
+        else
+        {
+            if (tries == 8)
+            {
+                /* Rare observer contention only, never on an ordinary warm hit.
+                 * Once blocked, complete the snapshot under Wine's existing set. */
+                if (pthread_sigmask( SIG_BLOCK, &server_block_set, &previous ))
+                    return PW_BOP_CONTEXT_INVALID; /* caller retains view storage until recovery */
+                blocked = 1;
+            }
+            __atomic_store_n( &view->phase, PW_BOP_CONTEXT_COPYING, __ATOMIC_RELEASE );
+            memcpy( canonical, shadow, sizeof(*canonical) );
+            if (!__atomic_load_n( &view->changes, __ATOMIC_ACQUIRE ) && disposition == PW_BOP_CONTEXT_HIT)
+                canonical->Eax = STATUS_SUCCESS;
+            expected = PW_BOP_CONTEXT_COPYING;
+            if (__atomic_compare_exchange_n( &view->phase, &expected, PW_BOP_CONTEXT_COMMITTED,
+                                              0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE )) break;
+        }
+    }
+    changed = __atomic_load_n( &view->changes, __ATOMIC_ACQUIRE );
+    __atomic_store_n( &data->ps5_sync_bop_context, NULL, __ATOMIC_RELEASE );
+    if (blocked) pthread_sigmask( SIG_SETMASK, &previous, NULL );
+    return changed || (cpu->Flags & WOW64_CPURESERVED_FLAG_RESET_STATE) ?
+           PW_BOP_CONTEXT_REPLACED : PW_BOP_CONTEXT_UNCHANGED;
+}
+
+DECLSPEC_EXPORT const struct pw_sync_bop_context_backend *__wine_ps5_sync_bop_context_backend(uint32_t version)
+{
+    static const struct pw_sync_bop_context_backend api =
+    {
+        PW_BOP_CONTEXT_VERSION, sizeof(api), sizeof(void *), sizeof(I386_CONTEXT),
+        ps5_sync_bop_context_publish, ps5_sync_bop_context_finish
+    };
+    return version == PW_BOP_CONTEXT_VERSION ? &api : NULL;
+}
+#else
+static XSAVE_FORMAT *ps5_sync_bop_fp_area( struct thread_data *data, struct syscall_frame *frame )
+{
+    return &frame->xsave;
+}
+#endif
